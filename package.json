{
  "name": "codex-image-studio",
  "version": "1.7.1",
  "private": true,
  "type": "module",
  "description": "ChatGPT認証のCodex CLIで動くローカル画像生成スタジオ",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "npm run build",
    "dev": "node --env-file-if-exists=.env dist/server.js",
    "prestart": "npm run build",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "build": "npm run build:server && npm run build:frontend",
    "build:server": "tsc -p tsconfig.server.json && node dist/scripts/prepare-test-fixtures.js",
    "build:frontend": "vite build",
    "test": "npm run build && node --test dist/test/*.test.js && npm run test:frontend",
    "test:frontend": "vitest run",
    "check": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit && npm run build",
    "predoctor": "npm run build:server",
    "doctor": "node --env-file-if-exists=.env dist/scripts/doctor.js"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.49.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
