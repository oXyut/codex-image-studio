{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./frontend/src/*"],
      "@legacy/*": ["./public/*"]
    },
    "types": ["vite/client", "node"]
  },
  "include": [
    "frontend/src",
    "vite.config.ts",
    "public/prompt-utils.js",
    "public/canvas-options.js",
    "public/lineage-utils.js",
    "public/batch-groups.js",
    "public/template-diff.js",
    "public/draft-state.js"
  ]
}
