# インストール済みのCodex CLIを使用します。APIキーは不要です。
# CODEX_BIN=/Users/your-name/.local/bin/codex
PORT=4317
# 同じWi-Fiのスマホ接続を有効にする場合のみ、このMacのプライベートIPv4を指定。
# 未承認端末は画像・履歴・操作APIを利用できません。Macで一時コードを発行します。
# LAN_HOST=192.168.11.11
# 任意: アカウントで利用できるCodexモデル。未指定・空欄ならGPT-6 Lunaを使用。
# 推論量はmedium（Middle）を明示します。
# CODEX_MODEL=gpt-6-luna
# 画像生成を待つ上限（ミリ秒、既定10分）
GENERATION_TIMEOUT_MS=600000
# 最大同時生成数（1〜10件、既定5件）
GENERATION_CONCURRENCY=5
